  "main": "index.js",
  "scripts": {
    "build:shared": "npm --workspace @clash/shared run build",
    "build:server": "npm --workspace @clash/server run build",
    "build:client": "npm --workspace template-react-ts run build-nolog",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "dev:server": "npm --workspace @clash/server run start:dev",
    "dev:client": "npm --workspace template-react-ts run dev-nolog",
    "test:shared": "npm --workspace @clash/shared run test",
    "test:server": "npm --workspace @clash/server run test:e2e",
    "test": "npm run build:shared && npm run test:shared && npm run test:server"
  },
